# App + Alembic: use postgresql+asyncpg:// (Alembic maps +asyncpg → +psycopg for migrations).
# If you see "getaddrinfo failed" on Windows, the direct host db.xxxxx.supabase.co often has
# only IPv6; use the Transaction pooler URI from Supabase instead (host like *.pooler.supabase.com:6543).
# Add ?ssl=require if your client needs it (common with Supabase).
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxxx.supabase.co:5432/postgres?ssl=require

# Project URL from Dashboard → Settings → API → Project URL (no trailing slash).
# Required for ES256 / RS256 tokens: backend loads JWKS from {SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Legacy JWT secret (Dashboard → JWT → legacy HS256). Only needed if you still issue or accept HS256 access tokens.
# For local tests that mint HS256 JWTs yourself, set any shared secret (e.g. dev-change-me) and match your token signer.
# If you only use asymmetric signing (ES256 / RS256 via JWKS), you can leave this empty.
SUPABASE_JWT_SECRET=

# Optional. Cache duration for JWKS (seconds). Default 600 matches Supabase edge caching ballpark.
# SUPABASE_JWKS_CACHE_SECONDS=600

REDIS_URL=redis://localhost:6379/0
APP_ENV=development
SECRET_KEY=change-me
ALLOWED_ORIGINS=http://localhost:3000
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# LLM providers for AI-based secondary sales import (POST /v1/secondary-sales/import-jobs).
# Gemini is primary (cheapest + largest context). OpenAI is used as fallback if Gemini fails or is rate-limited.
# At least one must be set; if both are empty, import-job processing will error.
# Get Gemini key: https://aistudio.google.com/app/apikey
# Get OpenAI key: https://platform.openai.com/api-keys
GEMINI_API_KEY=
OPENAI_API_KEY=

# MinerU document parsing API. Converts PDF -> clean markdown BEFORE the LLM
# extraction step, so Gemini never has to read a binary PDF directly.
# Free token (200 MB / 600 pages per file): https://mineru.net/apiManage/token
# If empty, the pipeline transparently falls back to Gemini Files API (slower).
MINERU_API_KEY=

# Logging level for app loggers (DEBUG | INFO | WARNING | ERROR). Default INFO.
# Set to DEBUG to investigate slow imports / failures in detail.
LOG_LEVEL=INFO
